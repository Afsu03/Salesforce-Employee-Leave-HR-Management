# Salesforce integration (example environment)

# Salesforce instance base URL, e.g. https://your-domain.my.salesforce.com
VITE_SF_INSTANCE_URL=

# API version to use (e.g. 58.0)
VITE_SF_API_VERSION=58.0

# OAuth Client ID from your Connected App (optional for server-side flows)
VITE_SF_CLIENT_ID=

# The redirect URI you register in the Connected App (for browser-based OAuth)
VITE_SF_REDIRECT_URI=

# If you use a server-side refresh token flow, you might set a BACKEND endpoint here
VITE_SF_PROXY_URL=
